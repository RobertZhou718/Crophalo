{
  "$description": "Crophalo design tokens. Every value here is the value in the first :root block of css/app.css. Light mode only. One blue for every action and selected state.",
  "color": {
    "surface": {
      "bg": {
        "$type": "color",
        "$value": "#f2f2f4",
        "$description": "Page background; also the theme colour of the installed app.",
        "$extensions": {
          "css": "--bg"
        }
      },
      "card": {
        "$type": "color",
        "$value": "#ffffff",
        "$description": "Face of every card and control.",
        "$extensions": {
          "css": "--card"
        }
      },
      "card2": {
        "$type": "color",
        "$value": "#f9f9fb",
        "$description": "Second surface: table heads, inset boxes, hover.",
        "$extensions": {
          "css": "--card2"
        }
      },
      "bar": {
        "$type": "color",
        "$value": "#f6f6f8",
        "$description": "Solid colour of the top bars.",
        "$extensions": {
          "css": "--bar"
        }
      },
      "bar-glass": {
        "$type": "color",
        "$value": "#f6f6f8e6",
        "$description": "The top bar as glass. Almost opaque, so its words keep 4.5:1 even over a dark photo.",
        "$extensions": {
          "css": "--bar-glass"
        }
      },
      "glass": {
        "$type": "color",
        "$value": "#f6f6f8b8",
        "$description": "Glass for map buttons, with a 20 px blur behind.",
        "$extensions": {
          "css": "--glass"
        }
      },
      "toast": {
        "$type": "color",
        "$value": "#28282beb",
        "$description": "Toast background; its words are white.",
        "$extensions": {
          "css": "--toast"
        }
      },
      "offline": {
        "$type": "color",
        "$value": "#fff4d6",
        "$description": "Background of the offline bar.",
        "$extensions": {
          "css": "--offline"
        }
      },
      "backdrop": {
        "$type": "color",
        "$value": "#00000052",
        "$description": "Dim layer behind a sheet, blurred 4 px.",
        "$extensions": {
          "css": "--backdrop"
        }
      },
      "backdrop-welcome": {
        "$type": "color",
        "$value": "#14182075",
        "$description": "Dim layer behind the welcome sheet, blurred 10 px.",
        "$extensions": {
          "css": "--backdrop-welcome"
        }
      },
      "map-placeholder": {
        "$type": "color",
        "$value": "#1f2a24",
        "$description": "Shown where a map or satellite picture has not arrived yet.",
        "$extensions": {
          "css": "--map-ph"
        }
      }
    },
    "fill": {
      "fill": {
        "$type": "color",
        "$value": "#7878801f",
        "$description": "Neutral fill: segment track, chips, tabs, skeletons.",
        "$extensions": {
          "css": "--fill"
        }
      },
      "fill2": {
        "$type": "color",
        "$value": "#78788012",
        "$description": "Lighter fill: hover rows, icon buttons, calendar cells.",
        "$extensions": {
          "css": "--fill2"
        }
      },
      "seg-thumb": {
        "$type": "color",
        "$value": "#ffffff",
        "$description": "The white thumb of the segmented control.",
        "$extensions": {
          "css": "--seg-thumb"
        }
      },
      "cell": {
        "$type": "color",
        "$value": "#e7e9ee",
        "$description": "Empty cell in a chart or calendar.",
        "$extensions": {
          "css": "--cell"
        }
      }
    },
    "text": {
      "ink": {
        "$type": "color",
        "$value": "#1d1d1f",
        "$description": "Main text.",
        "$extensions": {
          "css": "--ink"
        }
      },
      "ink2": {
        "$type": "color",
        "$value": "#3c3c43cc",
        "$description": "Second text: captions, helper lines, quiet labels (at least 4.5:1).",
        "$extensions": {
          "css": "--ink2"
        }
      },
      "ink3": {
        "$type": "color",
        "$value": "#3c3c4373",
        "$description": "Third level. About 2.4:1, so never used for words.",
        "$extensions": {
          "css": "--ink3"
        }
      },
      "accent-ink": {
        "$type": "color",
        "$value": "#ffffff",
        "$description": "Words on the blue.",
        "$extensions": {
          "css": "--accent-ink"
        }
      },
      "link": {
        "$type": "color",
        "$value": "#0959c4",
        "$description": "Text links and the outlined \"i\".",
        "$extensions": {
          "css": "--link"
        }
      },
      "offline-ink": {
        "$type": "color",
        "$value": "#5a4300",
        "$description": "Words on the offline bar.",
        "$extensions": {
          "css": "--offline-ink"
        }
      }
    },
    "separator": {
      "sep": {
        "$type": "color",
        "$value": "#3c3c4329",
        "$description": "Hairlines and the half-pixel ring around cards.",
        "$extensions": {
          "css": "--sep"
        }
      },
      "sep2": {
        "$type": "color",
        "$value": "#3c3c4317",
        "$description": "Lighter line between rows of a list.",
        "$extensions": {
          "css": "--sep2"
        }
      },
      "offline-line": {
        "$type": "color",
        "$value": "#e6cf8a",
        "$description": "Bottom line of the offline bar.",
        "$extensions": {
          "css": "--offline-line"
        }
      }
    },
    "control": {
      "ctl": {
        "$type": "color",
        "$value": "#8a8a8e",
        "$description": "Edge of a field, switch track and slider track (at least 3:1 on white and on the page).",
        "$extensions": {
          "css": "--ctl"
        }
      }
    },
    "accent": {
      "accent": {
        "$type": "color",
        "$value": "#0a63d8",
        "$description": "The one blue: main buttons, selected rings, switch on, slider fill, count badge.",
        "$extensions": {
          "css": "--accent"
        }
      },
      "accent-soft": {
        "$type": "color",
        "$value": "#0a63d81f",
        "$description": "Soft blue tint behind a chosen thing.",
        "$extensions": {
          "css": "--accent-soft"
        }
      },
      "accent-text": {
        "$type": "color",
        "$value": "#0959c4",
        "$description": "Accent for text on tinted backgrounds (passes 4.5:1).",
        "$extensions": {
          "css": "--accent-text"
        }
      },
      "src-tint": {
        "$type": "color",
        "$value": "#0959c421",
        "$description": "Tint behind a source tag.",
        "$extensions": {
          "css": "--src-tint"
        }
      },
      "focus-soft": {
        "$type": "color",
        "$value": "#0a63d82e",
        "$description": "Soft halo around a focused field and a held slider thumb.",
        "$extensions": {
          "css": "--focus-soft"
        }
      }
    },
    "selection": {
      "sel": {
        "$type": "color",
        "$value": "{color.accent.accent}",
        "$description": "Focus ring and selected option. The same blue as the accent.",
        "$extensions": {
          "css": "--sel"
        }
      }
    },
    "status": {
      "good": {
        "$type": "color",
        "$value": "#1b7532",
        "$description": "The Good status, and only that.",
        "$extensions": {
          "css": "--good"
        }
      },
      "good-soft": {
        "$type": "color",
        "$value": "#248a3d21",
        "$description": "Tint behind a Good tag.",
        "$extensions": {
          "css": "--good-soft"
        }
      },
      "warn": {
        "$type": "color",
        "$value": "#8f5100",
        "$description": "Watch words and risks (brown-orange).",
        "$extensions": {
          "css": "--warn"
        }
      },
      "warn-soft": {
        "$type": "color",
        "$value": "#ff9f0a26",
        "$description": "Tint behind a Watch tag.",
        "$extensions": {
          "css": "--warn-soft"
        }
      },
      "bad": {
        "$type": "color",
        "$value": "#d70015",
        "$description": "Risk, errors, the Delete word.",
        "$extensions": {
          "css": "--bad"
        }
      },
      "bad-soft": {
        "$type": "color",
        "$value": "#ff3b301a",
        "$description": "Tint behind a Risk tag.",
        "$extensions": {
          "css": "--bad-soft"
        }
      },
      "watch": {
        "$type": "color",
        "$value": "#a86f00",
        "$description": "The one amber for Watch marks: ring, bar, dot (at least 3:1; not for words).",
        "$extensions": {
          "css": "--watch"
        }
      },
      "delete": {
        "$type": "color",
        "$value": "#b3001a",
        "$description": "Face of an armed Delete button; its word is white.",
        "$extensions": {
          "css": "--delete"
        }
      }
    },
    "chart": {
      "rain": {
        "$type": "color",
        "$value": "#2a77d4",
        "$description": "Chart mark: rain.",
        "$extensions": {
          "css": "--c-rain"
        }
      },
      "et": {
        "$type": "color",
        "$value": "#0e8a74",
        "$description": "Chart mark: water lost to the air.",
        "$extensions": {
          "css": "--c-et"
        }
      },
      "hi": {
        "$type": "color",
        "$value": "#c4620a",
        "$description": "Chart mark: daily highs.",
        "$extensions": {
          "css": "--c-hi"
        }
      },
      "lo": {
        "$type": "color",
        "$value": "#5b86d6",
        "$description": "Chart mark: nightly lows.",
        "$extensions": {
          "css": "--c-lo"
        }
      },
      "green": {
        "$type": "color",
        "$value": "#2a8a44",
        "$description": "Chart mark: plant greenness.",
        "$extensions": {
          "css": "--c-g"
        }
      },
      "dry": {
        "$type": "color",
        "$value": "#b7782f",
        "$description": "Chart mark: dry.",
        "$extensions": {
          "css": "--c-dry"
        }
      },
      "wet": {
        "$type": "color",
        "$value": "#2670cc",
        "$description": "Chart mark: wet.",
        "$extensions": {
          "css": "--c-wet"
        }
      },
      "cover-part": {
        "$type": "color",
        "$value": "#9a7d1a",
        "$description": "Ground partly covered.",
        "$extensions": {
          "css": "--part"
        }
      },
      "cover-bare": {
        "$type": "color",
        "$value": "#b08060",
        "$description": "Bare soil; always drawn with a white hatch as well.",
        "$extensions": {
          "css": "--bare"
        }
      }
    },
    "field": {
      "soil": {
        "$type": "color",
        "$value": "#cbbf9f",
        "$description": "Earth in the field pictures.",
        "$extensions": {
          "css": "--soil"
        }
      },
      "sun": {
        "$type": "color",
        "$value": "#9a5b00",
        "$description": "Sun words and lines. Amber is for the sun only.",
        "$extensions": {
          "css": "--sun"
        }
      },
      "sun-fill": {
        "$type": "color",
        "$value": "#ffc233",
        "$description": "Sun fill.",
        "$extensions": {
          "css": "--sun-fill"
        }
      },
      "shade": {
        "$type": "color",
        "$value": "#0b2545",
        "$description": "Shade: navy, always with a hatch, never colour alone.",
        "$extensions": {
          "css": "--shade"
        }
      }
    },
    "logo": {
      "deep": {
        "$type": "color",
        "$value": "#174b3b",
        "$description": "Logo: the two furrow bars.",
        "$extensions": {
          "css": "--logo-deep"
        }
      },
      "mid": {
        "$type": "color",
        "$value": "#3e8b65",
        "$description": "Logo: the right field.",
        "$extensions": {
          "css": "--logo-mid"
        }
      },
      "lime": {
        "$type": "color",
        "$value": "#cadb74",
        "$description": "Logo: the bottom field.",
        "$extensions": {
          "css": "--logo-lime"
        }
      }
    }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": [
        {
          "color": "{color.separator.sep}",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0.5px"
        },
        {
          "color": "#0000000a",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        }
      ],
      "$description": "Card: a hairline ring and a whisper of shadow.",
      "$extensions": {
        "css": "--shadow"
      }
    },
    "large": {
      "$type": "shadow",
      "$value": [
        {
          "color": "{color.separator.sep}",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0.5px"
        },
        {
          "color": "#00000024",
          "offsetX": "0px",
          "offsetY": "10px",
          "blur": "40px",
          "spread": "0px"
        },
        {
          "color": "#0000000f",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "8px",
          "spread": "0px"
        }
      ],
      "$description": "Hover on acting cards, pop-overs, sheets.",
      "$extensions": {
        "css": "--shadow-lg"
      }
    },
    "control": {
      "$type": "shadow",
      "$value": [
        {
          "color": "{color.separator.sep}",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0.5px"
        },
        {
          "color": "#0000001a",
          "offsetX": "0px",
          "offsetY": "0.5px",
          "blur": "1.5px",
          "spread": "0px"
        }
      ],
      "$description": "Buttons.",
      "$extensions": {
        "css": "--shadow-ctl"
      }
    },
    "primary": {
      "$type": "shadow",
      "$value": {
        "color": "#0000002e",
        "offsetX": "0px",
        "offsetY": "0.5px",
        "blur": "1.5px",
        "spread": "0px"
      },
      "$description": "The blue main button.",
      "$extensions": {
        "css": "--shadow-primary"
      }
    },
    "map": {
      "$type": "shadow",
      "$value": {
        "color": "#00000047",
        "offsetX": "0px",
        "offsetY": "2px",
        "blur": "10px",
        "spread": "0px"
      },
      "$description": "Glass buttons over the map.",
      "$extensions": {
        "css": "--shadow-map"
      }
    },
    "thumb": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#00000024",
          "offsetX": "0px",
          "offsetY": "0.5px",
          "blur": "1px",
          "spread": "0px"
        },
        {
          "color": "#0000001a",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "3px",
          "spread": "0px"
        }
      ],
      "$description": "The white thumb of the chosen segment: a soft lift.",
      "$extensions": {
        "css": "--shadow-thumb"
      }
    }
