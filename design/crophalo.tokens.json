    "tag": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Source tags.",
      "$extensions": {
        "css": "--r-tag"
      }
    }
  },
  "font": {
    "family": {
      "text": {
        "$type": "fontFamily",
